---
import ThemeToggle from "./ThemeToggle.astro";
import { Image } from "astro:assets";
import { company, nav, contactCta } from "../data/site.js";
import logo from "../assets/logos/logo-no-background.svg";

const path = Astro.url.pathname;
const isActive = (href) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
  >
    <a href="/" class="flex items-center gap-3 shrink-0">
      <Image
        src={logo}
        alt={`${company.name} logo`}
        class="logo-mark h-10 w-auto sm:h-11"
      />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-4 py-2 text-sm font-medium transition-colors hover:text-brand-500",
              isActive(item.href) ? "text-brand-500" : "text-[var(--fg-muted)]",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href={contactCta.href}
        class="hidden rounded-full bg-brand-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md sm:inline-flex"
      >
        {contactCta.label}
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border)] text-[var(--fg)] lg:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-5 w-5"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-[var(--border)] px-4 py-3 lg:hidden"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--fg-muted)] hover:bg-brand-500/10 hover:text-brand-500"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={contactCta.href}
      class="mt-1 rounded-lg bg-brand-600 px-3 py-2 text-center text-sm font-semibold text-white"
    >
      {contactCta.label}
    </a>
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    btn?.addEventListener("click", () => {
      const isHidden = menu?.classList.contains("hidden");
      menu?.classList.toggle("hidden", !isHidden ? true : false);
      menu?.classList.toggle("flex", isHidden);
      btn.setAttribute("aria-expanded", String(isHidden));
    });
  })();
</script>
