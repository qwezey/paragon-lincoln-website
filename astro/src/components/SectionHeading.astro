---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "reveal max-w-3xl",
    align === "center" && "mx-auto text-center",
    className,
  ]}
>
  {
    eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
        {eyebrow}
      </p>
    )
  }
  <h2
    class="mt-2 text-3xl font-bold tracking-tight text-[var(--fg)] sm:text-4xl"
  >
    {title}
  </h2>
  {
    description && (
      <p class="mt-4 text-lg text-[var(--fg-muted)]">{description}</p>
    )
  }
</div>
