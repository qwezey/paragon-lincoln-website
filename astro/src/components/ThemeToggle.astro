---
// Theme menu with explicit light, dark, and system choices.
---

<div id="theme-menu-wrapper" class="relative">
  <button
    id="theme-toggle"
    type="button"
    aria-label="Choose color theme"
    aria-expanded="false"
    aria-haspopup="menu"
    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border)] text-[var(--fg)] transition-colors hover:bg-brand-500/10"
  >
    <svg
      data-theme-icon="system"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-5 w-5"
    >
      <rect x="3" y="4" width="18" height="13" rx="2"></rect><path
        d="M8 21h8M12 17v4"></path>
    </svg>
    <svg
      data-theme-icon="light"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden h-5 w-5"
    >
      <circle cx="12" cy="12" r="4"></circle><path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path>
    </svg>
    <svg
      data-theme-icon="dark"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden h-5 w-5"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
    </svg>
  </button>
  <div
    id="theme-menu"
    role="menu"
    class="absolute right-0 top-11 z-10 hidden w-32 rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] p-1 shadow-lg"
  >
    {
      ["system", "light", "dark"].map((theme) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked="false"
          data-theme-option={theme}
          class="block w-full rounded-md px-3 py-2 text-left text-sm text-[var(--fg)] hover:bg-brand-500/10"
        >
          {theme[0].toUpperCase() + theme.slice(1)}
        </button>
      ))
    }
  </div>
</div>

<script is:inline>
  (function () {
    const toggle = document.getElementById("theme-toggle");
    const menu = document.getElementById("theme-menu");
    const wrapper = document.getElementById("theme-menu-wrapper");
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const options = document.querySelectorAll("[data-theme-option]");
    const icons = document.querySelectorAll("[data-theme-icon]");

    const applyTheme = (theme) => {
      const root = document.documentElement;
      root.classList.toggle(
        "dark",
        theme === "dark" || (theme === "system" && media.matches),
      );
      icons.forEach((icon) =>
        icon.classList.toggle("hidden", icon.dataset.themeIcon !== theme),
      );
      options.forEach((option) =>
        option.setAttribute(
          "aria-checked",
          String(option.dataset.themeOption === theme),
        ),
      );
    };

    let theme = localStorage.getItem("theme");
    theme = ["light", "dark", "system"].includes(theme) ? theme : "system";
    applyTheme(theme);

    toggle?.addEventListener("click", () => {
      const isOpen = !menu?.classList.contains("hidden");
      menu?.classList.toggle("hidden", isOpen);
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });
    options.forEach((option) =>
      option.addEventListener("click", () => {
        theme = option.dataset.themeOption;
        localStorage.setItem("theme", theme);
        applyTheme(theme);
        menu?.classList.add("hidden");
        toggle?.setAttribute("aria-expanded", "false");
      }),
    );
    media.addEventListener("change", () => {
      if (theme === "system") applyTheme(theme);
    });
    document.addEventListener("click", (event) => {
      if (!wrapper?.contains(event.target)) {
        menu?.classList.add("hidden");
        toggle?.setAttribute("aria-expanded", "false");
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        menu?.classList.add("hidden");
        toggle?.setAttribute("aria-expanded", "false");
      }
    });
  })();
</script>
