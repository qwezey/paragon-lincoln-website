---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { company, pmContacts } from "../../data/site.js";

const serviceOptions = [
  "Civil Engineering Design / Site Design",
  "Construction Inspection",
  "Construction Management",
  "Project Management",
  "Information Technology",
  "Other",
];
---

<Layout
  title="Contact Us | Paragon Lincoln Engineering"
  description="Tell us about your project. Submit an online service request or reach a Paragon Lincoln Engineering project manager directly."
>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Contact Us"
      title="Let's Discuss Your Project"
      description="Whether you need assistance planning a new development, designing a building or site, managing construction, conducting inspections, documenting construction, developing a residential community, or addressing a technology need, PARAGON is ready to help develop practical solutions."
    />

    <div class="mt-12 grid gap-12 lg:grid-cols-5">
      <!-- Form -->
      <form
        id="service-request-form"
        class="reveal lg:col-span-3 space-y-6 rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6 sm:p-8"
      >
        <h2 class="text-lg font-semibold text-[var(--fg)]">
          Online Service Request Form
        </h2>
        <p class="text-sm text-[var(--fg-muted)]">
          Please provide the following information so we can better understand
          your project and service needs.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1 text-sm text-[var(--fg-muted)]">
            Name*
            <input
              required
              name="name"
              type="text"
              class="rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-[var(--fg)] outline-none focus:border-brand-500"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm text-[var(--fg-muted)]">
            Company / Organization*
            <input
              required
              name="company"
              type="text"
              class="rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-[var(--fg)] outline-none focus:border-brand-500"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm text-[var(--fg-muted)]">
            Email*
            <input
              required
              name="email"
              type="email"
              class="rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-[var(--fg)] outline-none focus:border-brand-500"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm text-[var(--fg-muted)]">
            Phone*
            <input
              required
              name="phone"
              type="tel"
              class="rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-[var(--fg)] outline-none focus:border-brand-500"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm text-[var(--fg-muted)]">
            Project Location*
            <input
              required
              name="location"
              type="text"
              class="rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-[var(--fg)] outline-none focus:border-brand-500"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm text-[var(--fg-muted)]">
            Project Owner / Client*
            <input
              required
              name="owner"
              type="text"
              class="rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-[var(--fg)] outline-none focus:border-brand-500"
            />
          </label>
        </div>

        <fieldset>
          <legend class="text-sm font-medium text-[var(--fg)]"
            >Service Requested</legend
          >
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {
              serviceOptions.map((option) => (
                <label class="flex items-center gap-2 text-sm text-[var(--fg-muted)]">
                  <input
                    type="checkbox"
                    name="services"
                    value={option}
                    class="h-4 w-4 rounded border-[var(--border)] text-brand-600 focus:ring-brand-500"
                  />
                  {option}
                </label>
              ))
            }
          </div>
        </fieldset>

        <label class="flex flex-col gap-1 text-sm text-[var(--fg-muted)]">
          Brief Description of Your Project / Work
          <textarea
            name="description"
            rows="4"
            class="rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-[var(--fg)] outline-none focus:border-brand-500"
          ></textarea>
        </label>

        <p class="text-xs text-[var(--fg-muted)]">* Required Information</p>

        <button
          type="submit"
          class="w-full rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-lg sm:w-auto"
        >
          Submit Request
        </button>
        <p id="form-status" class="text-sm text-[var(--fg-muted)]"></p>
      </form>

      <!-- Contact details -->
      <div class="reveal lg:col-span-2 space-y-6">
        <div
          class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6"
        >
          <h2 class="text-lg font-semibold text-[var(--fg)]">
            Paragon L Engineering
          </h2>
          <p class="mt-2 text-sm text-[var(--fg-muted)]">
            Office Locations: {company.locations}
          </p>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">
            Website: {company.website}
          </p>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">
            Email: <a
              href={`mailto:${company.email}`}
              class="text-brand-500 hover:underline">{company.email}</a>
          </p>
        </div>

        <div
          class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6"
        >
          <h2 class="text-lg font-semibold text-[var(--fg)]">
            Project Managers' Contacts
          </h2>
          <ul class="mt-4 space-y-4">
            {
              pmContacts.map((c) => (
                <li class="border-t border-[var(--border)] pt-4 first:border-t-0 first:pt-0">
                  <p class="text-sm font-medium text-[var(--fg)]">
                    {c.department}
                  </p>
                  <p class="mt-1 text-sm text-[var(--fg-muted)]">
                    Text: {c.text} &nbsp;|&nbsp; Phone: {c.phone}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  /* Static-site friendly submission: composes a pre-filled email since there is no backend/CMS. */
  const form = document.getElementById("service-request-form");
  const status = document.getElementById("form-status");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const services = data.getAll("services").join(", ") || "Not specified";
    const lines = [
      `Name: ${data.get("name")}`,
      `Company / Organization: ${data.get("company")}`,
      `Email: ${data.get("email")}`,
      `Phone: ${data.get("phone")}`,
      `Project Location: ${data.get("location")}`,
      `Project Owner / Client: ${data.get("owner")}`,
      `Service(s) Requested: ${services}`,
      `Description: ${data.get("description") || ""}`,
    ];
    const subject = encodeURIComponent(
      "Online Service Request — Paragon Lincoln Engineering",
    );
    const body = encodeURIComponent(lines.join("\n"));
    window.location.href = `mailto:info@paragonln.com?subject=${subject}&body=${body}`;
    if (status)
      status.textContent = "Opening your email client to send this request…";
  });
</script>
