---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { sectors } from "../../data/site.js";
---

<Layout
  title="Sectors | Paragon Lincoln Engineering"
  description="Paragon L Engineering provides services across a diverse range of commercial, industrial, institutional, infrastructure, and technology sectors."
>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Sectors We Serve"
      title="Multidisciplinary Experience Across Physical and Digital Environments"
      description="Paragon L Engineering provides services across a diverse range of sectors, supporting projects from initial planning through construction, inspection, and technology implementation."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        sectors.map((sector, index) => (
          <div
            class="reveal rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6 transition-transform duration-300 hover:-translate-y-1 hover:shadow-lg"
            style={`animation-delay:${index * 80}ms`}
          >
            <h3 class="text-lg font-semibold text-[var(--fg)]">
              {sector.title}
            </h3>
            <ul class="mt-4 space-y-2">
              {sector.items.map((item) => (
                <li class="flex items-start gap-2 text-sm text-[var(--fg-muted)]">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
