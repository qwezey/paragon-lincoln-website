---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { certifications, whyParagon } from "../../data/site.js";
---

<Layout
  title="About Us | Paragon Lincoln Engineering"
  description="Who We Are, our leadership, and our certifications as a Minority, Women, and Small Business Enterprise."
>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="About"
      title="Who We Are"
      description="Paragon L Engineering is a multidisciplinary professional services firm positioned at the intersection of engineering, construction, project delivery, and technology."
    />

    <div class="reveal mt-8 max-w-3xl space-y-4 text-[var(--fg-muted)]">
      <p>
        PARAGON was founded in 2010 by <strong class="text-[var(--fg)]"
          >Atiya Azmat, P.E.</strong
        >, who serves as Chief Executive Officer. <strong
          class="text-[var(--fg)]">Shahid Iqbal, Ph.D., P.E.</strong
        > joined the firm in 2012 as Principal and Director of Engineering, bringing
        extensive experience in engineering, design, project management, and construction
        management.
      </p>
      <p>
        Together, the firm's leadership provides a combination of engineering
        expertise, construction knowledge, project-management experience, and
        client-focused professional service. Our team of Project Managers and
        Technical Staff is committed to providing responsive, reliable,
        practical, and solution-oriented services tailored to the specific
        requirements of each assignment.
      </p>
      <p>
        Our goal is to help clients complete their projects safely, efficiently,
        on schedule, within budget, and to the required standards of quality and
        professionalism.
      </p>
    </div>
  </section>

  <section class="bg-[var(--bg-elevated)] py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="reveal text-2xl font-bold text-[var(--fg)]">
        We Believe Successful Projects Require
      </h2>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          [
            "Technical competence",
            "Clear communication",
            "Collaboration",
            "Accountability",
            "Constructability",
            "Cost awareness",
            "Schedule discipline",
            "Quality control",
            "Proactive risk management",
            "Reliable documentation",
          ].map((item) => (
            <span class="reveal rounded-full border border-[var(--border)] px-4 py-2 text-sm text-[var(--fg-muted)]">
              {item}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="reveal text-2xl font-bold text-[var(--fg)]">Why Paragon?</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        whyParagon.map((item, index) => (
          <div
            class="reveal rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6 transition-transform duration-300 hover:-translate-y-1"
            style={`animation-delay:${index * 80}ms`}
          >
            <h3 class="font-semibold text-[var(--fg)]">{item.title}</h3>
            <p class="mt-2 text-sm text-[var(--fg-muted)]">{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="certifications"
    class="scroll-mt-24 bg-[var(--bg-elevated)] py-16"
  >
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Certifications"
        title="Paragon L Engineering is Certified As"
        align="center"
        class="mx-auto"
      />
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        {
          certifications.map((c) => (
            <span class="reveal rounded-full bg-brand-600/10 px-5 py-3 text-sm font-semibold text-brand-500">
              {c}
            </span>
          ))
        }
      </div>
      <p class="reveal mt-6 text-sm text-[var(--fg-muted)]">
        These certifications support PARAGON's participation in public- and
        private-sector procurement opportunities and diversity contracting
        programs.
      </p>
    </div>
  </section>
</Layout>
