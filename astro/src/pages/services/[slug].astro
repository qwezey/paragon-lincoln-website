---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { Image } from "astro:assets";
import { services } from "../../data/site.js";
import { imageAssets } from "../../data/image-assets.js";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const otherServices = services.filter((s) => s.slug !== service.slug);
---

<Layout
  title={`${service.title} | Paragon Lincoln Engineering`}
  description={service.summary}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[var(--bg-elevated)]">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-24"
    >
      <div class="reveal is-visible">
        <p
          class="text-sm font-semibold uppercase tracking-widest text-brand-500"
        >
          Services
        </p>
        <h1
          class="mt-3 text-3xl font-bold tracking-tight text-[var(--fg)] sm:text-4xl lg:text-5xl"
        >
          {service.title}
        </h1>
        <p class="mt-4 text-lg font-medium text-[var(--fg)]">{service.short}</p>
        <p class="mt-4 text-[var(--fg-muted)]">{service.summary}</p>
        <a
          href="/contact/"
          class="mt-8 inline-flex rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-lg"
        >
          Discuss This Service
        </a>
      </div>
      <Image
        src={imageAssets[service.image]}
        alt={service.title}
        class="reveal is-visible aspect-[4/3] w-full rounded-2xl object-cover shadow-lg"
      />
    </div>
  </section>

  <!-- Sections -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="space-y-16">
      {
        service.sections.map((section, i) => (
          <div
            class:list={[
              "grid gap-8 lg:grid-cols-2 lg:items-center",
              section.image && i % 2 === 1 && "lg:[&>*:first-child]:order-2",
            ]}
          >
            <div class="reveal">
              <h2 class="text-2xl font-bold text-[var(--fg)]">
                {section.heading}
              </h2>
              {section.paragraphs?.map((p) => (
                <p class="mt-4 text-[var(--fg-muted)]">{p}</p>
              ))}
              {section.list && (
                <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                  {section.list.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-[var(--fg-muted)]">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 h-4 w-4 shrink-0 text-brand-500"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              )}
              {section.tools && (
                <p class="mt-4 rounded-lg bg-[var(--bg)] px-4 py-3 text-sm text-[var(--fg-muted)]">
                  <span class="font-semibold text-[var(--fg)]">
                    Technology & Tools:{" "}
                  </span>
                  {section.tools}
                </p>
              )}
            </div>
            {section.image && (
              <Image
                src={imageAssets[section.image]}
                alt={section.heading}
                class="reveal aspect-[4/3] w-full rounded-2xl object-cover shadow-md"
              />
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Contact -->
  <section class="bg-[var(--bg-elevated)] py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="reveal text-2xl font-bold text-[var(--fg)]">
        {service.title} — Contact
      </h2>
      <p class="reveal mt-3 text-[var(--fg-muted)]">
        Paragon L Engineering | Office Locations: NYS, NYC, NJ
      </p>
      <p class="reveal mt-1 text-[var(--fg-muted)]">
        Text: {service.contactText} &nbsp;|&nbsp; Phone: {service.contactPhone}
      </p>
      <a
        href="/contact/"
        class="reveal mt-6 inline-flex rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-lg"
      >
        Let's Discuss Your Requirements
      </a>
    </div>
  </section>

  <!-- Other services -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="reveal text-xl font-bold text-[var(--fg)]">
      Explore Other Services
    </h2>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        otherServices.map((s) => (
          <a
            href={`/services/${s.slug}/`}
            class="reveal rounded-full border border-[var(--border)] px-5 py-2 text-sm font-medium text-[var(--fg-muted)] transition-colors hover:border-brand-500 hover:text-brand-500"
          >
            {s.title
              .replace(" Services", "")
              .replace(" Services for Homebuilders & Developers", "")}
          </a>
        ))
      }
    </div>
  </section>
</Layout>
