---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getCollection } from "astro:content";
import { departments } from "../../data/site.js";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout
  title="Blog | Paragon Lincoln Engineering"
  description="Department blogs covering engineering design, project management, construction inspection, construction management, and information technology."
>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Insights"
      title="Department Blogs"
      description="Periodic articles and updates from each of our practice areas."
    />

    <div class="mt-10 flex flex-wrap gap-3">
      {
        departments.map((dept) => (
          <a
            href={`/blog/${dept.slug}/`}
            class="reveal rounded-full border border-[var(--border)] px-5 py-2 text-sm font-medium text-[var(--fg-muted)] transition-colors hover:border-brand-500 hover:text-brand-500"
          >
            {dept.title}
          </a>
        ))
      }
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, index) => {
          const dept = departments.find((d) => d.slug === post.data.department);
          return (
            <a
              href={`/blog/${post.data.department}/${post.id.split("/").pop()}/`}
              class="reveal flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
              style={`animation-delay:${index * 80}ms`}
            >
              <span class="text-xs font-semibold uppercase tracking-wide text-brand-500">
                {dept?.title}
              </span>
              <h2 class="mt-2 text-lg font-semibold text-[var(--fg)]">
                {post.data.title}
              </h2>
              <p class="mt-2 flex-1 text-sm text-[var(--fg-muted)]">
                {post.data.description}
              </p>
              <time class="mt-4 text-xs text-[var(--fg-muted)]">
                {post.data.publishDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>
